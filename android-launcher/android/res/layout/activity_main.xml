<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121316"
    android:padding="20dp">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minecraft: Legacy Console Edition"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_app_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MCPL Launcher &amp; Gestor de Recursos"
            android:textColor="#8E9297"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Center Card Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layout_header"
        android:layout_centerInParent="true"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="640dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <!-- 1. Progress View (Downloading / Extracting) -->
                <LinearLayout
                    android:id="@+id/layout_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Descargando recursos oficiales..."
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <ProgressBar
                        android:id="@+id/progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:progressDrawable="@drawable/progress_bar_custom"
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:max="100"
                        android:progress="0"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="#4CAF50"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_progress_details"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Conectando..."
                            android:textColor="#AAAAAA"
                            android:textSize="13sp"
                            android:gravity="right" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_extract_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#888888"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:ellipsize="middle"
                        android:layout_marginTop="8dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 2. Download Prompt View -->
                <LinearLayout
                    android:id="@+id/layout_download_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Se requieren los archivos de datos del juego"
                        android:textColor="#EEEEEE"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tv_free_space"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tamaño estimado del paquete: ~238 MB (Espacio libre: OK)"
                        android:textColor="#9E9E9E"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp" />

                    <!-- Local Detected Card (Auto-detected in Downloads) -->
                    <LinearLayout
                        android:id="@+id/layout_local_detected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#2A2E33"
                        android:padding="12dp"
                        android:gravity="center"
                        android:layout_marginBottom="14dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_local_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📦 Se detectó MCPL-Data.zip en tu carpeta de Descargas"
                            android:textColor="#81C784"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <Button
                            android:id="@+id/btn_install_local"
                            android:text="⚡ Instalar desde archivo local (Sin descarga)"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:background="@drawable/btn_mc_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp" />
                    </LinearLayout>

                    <!-- Main Download Button -->
                    <Button
                        android:id="@+id/btn_download"
                        android:text="📥 Descargar Recursos Oficiales (v1.0.1)"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_mc_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingLeft="24dp"
                        android:paddingRight="24dp"
                        android:layout_marginBottom="14dp" />

                    <!-- Secondary Options Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btn_pick_zip"
                            android:text="📂 Instalar ZIP manual"
                            android:textColor="#CCCCCC"
                            android:textSize="12sp"
                            android:background="@drawable/btn_mc_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:layout_marginRight="8dp" />

                        <Button
                            android:id="@+id/btn_open_dev"
                            android:text="⚙ Modo Desarrollador"
                            android:textColor="#CCCCCC"
                            android:textSize="12sp"
                            android:background="@drawable/btn_mc_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. Error View with Retry -->
                <LinearLayout
                    android:id="@+id/layout_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Error al instalar recursos"
                        android:textColor="#E57373"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_error_msg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No se pudo completar la operación."
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btn_retry"
                            android:text="🔄 Reintentar"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_mc_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:layout_marginRight="10dp" />

                        <Button
                            android:id="@+id/btn_error_back"
                            android:text="Volver al menú"
                            android:textColor="#CCCCCC"
                            android:textSize="13sp"
                            android:background="@drawable/btn_mc_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:paddingLeft="16dp"
                            android:paddingRight="16dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 4. Dev / Manual Launch View -->
                <LinearLayout
                    android:id="@+id/layout_dev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configuración de Almacenamiento"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_dev_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ruta donde residen los recursos del juego (MediaWindows64.arc):"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/directory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Directorio del juego"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#777777"
                        android:background="#2A2E33"
                        android:padding="12dp"
                        android:textSize="13sp"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/launch"
                            android:text="Iniciar Juego"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_mc_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:layout_marginRight="8dp" />

                        <Button
                            android:id="@+id/btn_dev_reset"
                            android:text="Restablecer"
                            android:textColor="#CCCCCC"
                            android:textSize="12sp"
                            android:background="@drawable/btn_mc_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:layout_marginRight="8dp" />

                        <Button
                            android:id="@+id/btn_dev_back"
                            android:text="Volver"
                            android:textColor="#CCCCCC"
                            android:textSize="12sp"
                            android:background="@drawable/btn_mc_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>